model User {
    id String @id @default(uuid())

    email String @unique
    password String

    username String @unique
    avatar String?

    verificationToken String
    verificationTokenExpiresAt DateTime 

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("users")
    
}

